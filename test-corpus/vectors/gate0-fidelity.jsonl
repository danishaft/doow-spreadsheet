{"id": "date-003", "area": "date", "source": "excel", "notes": "Day zero normalises to previous month end", "formula": "=DAY(DATE(2024,3,0))", "expected": {"kind": "number", "value": 29}, "tolerance": 0}
{"id": "date-004", "area": "date", "source": "excel", "notes": "Encoded date check for DATE(2024,3,0)", "formula": "=YEAR(DATE(2024,3,0))*10000+MONTH(DATE(2024,3,0))*100+DAY(DATE(2024,3,0))", "expected": {"kind": "number", "value": 20240229}, "tolerance": 0}
{"id": "date-005", "area": "date", "source": "excel", "notes": "EDATE clamps to month end", "formula": "=YEAR(EDATE(DATE(2024,1,31),1))*10000+MONTH(EDATE(DATE(2024,1,31),1))*100+DAY(EDATE(DATE(2024,1,31),1))", "expected": {"kind": "number", "value": 20240229}, "tolerance": 0}
{"id": "date-006", "area": "date", "source": "excel", "notes": "EOMONTH next month end", "formula": "=YEAR(EOMONTH(DATE(2024,1,15),1))*10000+MONTH(EOMONTH(DATE(2024,1,15),1))*100+DAY(EOMONTH(DATE(2024,1,15),1))", "expected": {"kind": "number", "value": 20240229}, "tolerance": 0}
{"id": "date-007", "area": "date", "source": "excel", "notes": "Month overflow normalises year", "formula": "=YEAR(DATE(2024,13,1))*10000+MONTH(DATE(2024,13,1))*100+DAY(DATE(2024,13,1))", "expected": {"kind": "number", "value": 20250101}, "tolerance": 0}
{"id": "date-008", "area": "date", "source": "excel", "notes": "DATEDIF years", "formula": "=DATEDIF(DATE(2020,1,31),DATE(2024,1,31),\"Y\")", "expected": {"kind": "number", "value": 4}, "tolerance": 0}
{"id": "date-009", "area": "date", "source": "excel", "notes": "DATEDIF months", "formula": "=DATEDIF(DATE(2020,1,31),DATE(2024,1,31),\"M\")", "expected": {"kind": "number", "value": 48}, "tolerance": 0}
{"id": "date-010", "area": "date", "source": "excel", "notes": "DATEDIF days including leap day 2020", "formula": "=DATEDIF(DATE(2020,1,31),DATE(2024,1,31),\"D\")", "expected": {"kind": "number", "value": 1461}, "tolerance": 0}
{"id": "date-011", "area": "date", "source": "excel", "notes": "DATEVALUE parses ISO date", "formula": "=DATEVALUE(\"2024-01-01\")-DATEVALUE(\"2023-12-31\")", "expected": {"kind": "number", "value": 1}, "tolerance": 0}
{"id": "date-012", "area": "date", "source": "excel", "notes": "TIME to fractional day", "formula": "=TIME(12,30,0)*24", "expected": {"kind": "number", "value": 12.5}, "tolerance": 0}
{"id": "date-013", "area": "date", "source": "excel", "notes": "HOUR on fractional day", "formula": "=HOUR(0.75)", "expected": {"kind": "number", "value": 18}, "tolerance": 0}
{"id": "date-014", "area": "date", "source": "excel", "notes": "WEEKDAY type 2: Monday=1", "formula": "=WEEKDAY(DATE(2024,1,1),2)", "expected": {"kind": "number", "value": 1}, "tolerance": 0}
{"id": "date-015", "area": "date", "source": "excel", "notes": "NETWORKDAYS January 2024", "formula": "=NETWORKDAYS(DATE(2024,1,1),DATE(2024,1,31))", "expected": {"kind": "number", "value": 23}, "tolerance": 0}
{"id": "date-016", "area": "date", "source": "excel", "notes": "YEARFRAC basis 0 (30/360)", "formula": "=YEARFRAC(DATE(2024,1,1),DATE(2024,7,1),0)", "expected": {"kind": "number", "value": 0.5}, "tolerance": 0}

{"id": "date-018", "area": "date", "source": "excel", "notes": "Day zero rolls back a year", "formula": "=YEAR(DATE(2024,1,0))*10000+MONTH(DATE(2024,1,0))*100+DAY(DATE(2024,1,0))", "expected": {"kind": "number", "value": 20231231}, "tolerance": 0}
{"id": "date-019", "area": "date", "source": "excel", "notes": "DAYS(end,start)", "formula": "=DAYS(DATE(2024,3,1),DATE(2024,2,1))", "expected": {"kind": "number", "value": 29}, "tolerance": 0}
{"id": "lookup-001", "area": "lookup", "source": "excel", "notes": "VLOOKUP exact match", "cells": [{"addr": "A1", "kind": "number", "value": 1}, {"addr": "B1", "kind": "text", "value": "a"}, {"addr": "A2", "kind": "number", "value": 2}, {"addr": "B2", "kind": "text", "value": "b"}, {"addr": "A3", "kind": "number", "value": 3}, {"addr": "B3", "kind": "text", "value": "c"}, {"addr": "A4", "kind": "number", "value": 4}, {"addr": "B4", "kind": "text", "value": "d"}], "formula": "=VLOOKUP(3,A1:B4,2,FALSE)", "expected": {"kind": "text", "value": "c"}}
{"id": "lookup-002", "area": "lookup", "source": "excel", "notes": "VLOOKUP approximate picks largest <= lookup", "cells": [{"addr": "A1", "kind": "number", "value": 1}, {"addr": "B1", "kind": "text", "value": "a"}, {"addr": "A2", "kind": "number", "value": 2}, {"addr": "B2", "kind": "text", "value": "b"}, {"addr": "A3", "kind": "number", "value": 3}, {"addr": "B3", "kind": "text", "value": "c"}, {"addr": "A4", "kind": "number", "value": 4}, {"addr": "B4", "kind": "text", "value": "d"}], "formula": "=VLOOKUP(2.5,A1:B4,2,TRUE)", "expected": {"kind": "text", "value": "b"}}
{"id": "lookup-003", "area": "lookup", "source": "excel", "notes": "VLOOKUP exact miss", "cells": [{"addr": "A1", "kind": "number", "value": 1}, {"addr": "B1", "kind": "text", "value": "a"}, {"addr": "A2", "kind": "number", "value": 2}, {"addr": "B2", "kind": "text", "value": "b"}, {"addr": "A3", "kind": "number", "value": 3}, {"addr": "B3", "kind": "text", "value": "c"}, {"addr": "A4", "kind": "number", "value": 4}, {"addr": "B4", "kind": "text", "value": "d"}], "formula": "=VLOOKUP(0,A1:B4,2,FALSE)", "expected": {"kind": "error", "value": "#N/A"}}
{"id": "lookup-004", "area": "lookup", "source": "excel", "notes": "Exact match does not coerce text to number", "cells": [{"addr": "A1", "kind": "number", "value": 1}, {"addr": "B1", "kind": "text", "value": "a"}, {"addr": "A2", "kind": "number", "value": 2}, {"addr": "B2", "kind": "text", "value": "b"}, {"addr": "A3", "kind": "number", "value": 3}, {"addr": "B3", "kind": "text", "value": "c"}, {"addr": "A4", "kind": "number", "value": 4}, {"addr": "B4", "kind": "text", "value": "d"}], "formula": "=VLOOKUP(\"3\",A1:B4,2,FALSE)", "expected": {"kind": "error", "value": "#N/A"}}
{"id": "lookup-005", "area": "lookup", "source": "excel", "notes": "Approximate lookup beyond last value returns last row", "cells": [{"addr": "A1", "kind": "number", "value": 1}, {"addr": "B1", "kind": "text", "value": "a"}, {"addr": "A2", "kind": "number", "value": 2}, {"addr": "B2", "kind": "text", "value": "b"}, {"addr": "A3", "kind": "number", "value": 3}, {"addr": "B3", "kind": "text", "value": "c"}, {"addr": "A4", "kind": "number", "value": 4}, {"addr": "B4", "kind": "text", "value": "d"}], "formula": "=VLOOKUP(4.5,A1:B4,2,TRUE)", "expected": {"kind": "text", "value": "d"}}
{"id": "lookup-006", "area": "lookup", "source": "excel", "notes": "MATCH exact returns 1-based position", "cells": [{"addr": "A1", "kind": "number", "value": 1}, {"addr": "A2", "kind": "number", "value": 2}, {"addr": "A3", "kind": "number", "value": 3}, {"addr": "A4", "kind": "number", "value": 4}], "formula": "=MATCH(3,A1:A4,0)", "expected": {"kind": "number", "value": 3}, "tolerance": 0}
{"id": "lookup-007", "area": "lookup", "source": "excel", "notes": "MATCH approx largest <= 2.5", "cells": [{"addr": "A1", "kind": "number", "value": 1}, {"addr": "A2", "kind": "number", "value": 2}, {"addr": "A3", "kind": "number", "value": 3}, {"addr": "A4", "kind": "number", "value": 4}], "formula": "=MATCH(2.5,A1:A4,1)", "expected": {"kind": "number", "value": 2}, "tolerance": 0}
{"id": "lookup-008", "area": "lookup", "source": "excel", "notes": "MATCH approx below smallest is #N/A", "cells": [{"addr": "A1", "kind": "number", "value": 1}, {"addr": "A2", "kind": "number", "value": 2}, {"addr": "A3", "kind": "number", "value": 3}, {"addr": "A4", "kind": "number", "value": 4}], "formula": "=MATCH(0,A1:A4,1)", "expected": {"kind": "error", "value": "#N/A"}}
{"id": "lookup-009", "area": "lookup", "source": "excel", "notes": "INDEX+MATCH composition", "cells": [{"addr": "A1", "kind": "number", "value": 1}, {"addr": "B1", "kind": "text", "value": "a"}, {"addr": "A2", "kind": "number", "value": 2}, {"addr": "B2", "kind": "text", "value": "b"}, {"addr": "A3", "kind": "number", "value": 3}, {"addr": "B3", "kind": "text", "value": "c"}, {"addr": "A4", "kind": "number", "value": 4}, {"addr": "B4", "kind": "text", "value": "d"}], "formula": "=INDEX(B1:B4,MATCH(3,A1:A4,0))", "expected": {"kind": "text", "value": "c"}}
{"id": "lookup-010", "area": "lookup", "source": "excel", "notes": "HLOOKUP exact", "cells": [{"addr": "H1", "kind": "number", "value": 1}, {"addr": "I1", "kind": "number", "value": 2}, {"addr": "J1", "kind": "number", "value": 3}, {"addr": "K1", "kind": "number", "value": 4}, {"addr": "H2", "kind": "text", "value": "w"}, {"addr": "I2", "kind": "text", "value": "x"}, {"addr": "J2", "kind": "text", "value": "y"}, {"addr": "K2", "kind": "text", "value": "z"}], "formula": "=HLOOKUP(3,H1:K2,2,FALSE)", "expected": {"kind": "text", "value": "y"}}
{"id": "lookup-011", "area": "lookup", "source": "excel", "notes": "VLOOKUP exact wildcard", "cells": [{"addr": "E1", "kind": "text", "value": "apple"}, {"addr": "F1", "kind": "number", "value": 1}, {"addr": "E2", "kind": "text", "value": "apricot"}, {"addr": "F2", "kind": "number", "value": 2}, {"addr": "E3", "kind": "text", "value": "banana"}, {"addr": "F3", "kind": "number", "value": 3}, {"addr": "E4", "kind": "text", "value": "cherry"}, {"addr": "F4", "kind": "number", "value": 4}], "formula": "=VLOOKUP(\"ap*\",E1:F4,2,FALSE)", "expected": {"kind": "number", "value": 1}, "tolerance": 0}
{"id": "lookup-012", "area": "lookup", "source": "excel", "notes": "VLOOKUP exact is case-insensitive", "cells": [{"addr": "E1", "kind": "text", "value": "apple"}, {"addr": "F1", "kind": "number", "value": 1}, {"addr": "E2", "kind": "text", "value": "apricot"}, {"addr": "F2", "kind": "number", "value": 2}, {"addr": "E3", "kind": "text", "value": "banana"}, {"addr": "F3", "kind": "number", "value": 3}, {"addr": "E4", "kind": "text", "value": "cherry"}, {"addr": "F4", "kind": "number", "value": 4}], "formula": "=VLOOKUP(\"APPLE\",E1:F4,2,FALSE)", "expected": {"kind": "number", "value": 1}, "tolerance": 0}
{"id": "lookup-013", "area": "lookup", "source": "excel", "notes": "XLOOKUP exact", "cells": [{"addr": "A1", "kind": "number", "value": 1}, {"addr": "B1", "kind": "text", "value": "a"}, {"addr": "A2", "kind": "number", "value": 2}, {"addr": "B2", "kind": "text", "value": "b"}, {"addr": "A3", "kind": "number", "value": 3}, {"addr": "B3", "kind": "text", "value": "c"}, {"addr": "A4", "kind": "number", "value": 4}, {"addr": "B4", "kind": "text", "value": "d"}], "formula": "=XLOOKUP(3,A1:A4,B1:B4)", "expected": {"kind": "text", "value": "c"}}
{"id": "lookup-014", "area": "lookup", "source": "excel", "notes": "XLOOKUP default miss is #N/A", "cells": [{"addr": "A1", "kind": "number", "value": 1}, {"addr": "B1", "kind": "text", "value": "a"}, {"addr": "A2", "kind": "number", "value": 2}, {"addr": "B2", "kind": "text", "value": "b"}, {"addr": "A3", "kind": "number", "value": 3}, {"addr": "B3", "kind": "text", "value": "c"}, {"addr": "A4", "kind": "number", "value": 4}, {"addr": "B4", "kind": "text", "value": "d"}], "formula": "=XLOOKUP(9,A1:A4,B1:B4)", "expected": {"kind": "error", "value": "#N/A"}}
{"id": "lookup-015", "area": "lookup", "source": "excel", "notes": "XLOOKUP if_not_found", "cells": [{"addr": "A1", "kind": "number", "value": 1}, {"addr": "B1", "kind": "text", "value": "a"}, {"addr": "A2", "kind": "number", "value": 2}, {"addr": "B2", "kind": "text", "value": "b"}, {"addr": "A3", "kind": "number", "value": 3}, {"addr": "B3", "kind": "text", "value": "c"}, {"addr": "A4", "kind": "number", "value": 4}, {"addr": "B4", "kind": "text", "value": "d"}], "formula": "=XLOOKUP(9,A1:A4,B1:B4,\"none\")", "expected": {"kind": "text", "value": "none"}}
{"id": "array-001", "area": "array", "source": "excel", "notes": "SEQUENCE vertical spill", "formula": "=SEQUENCE(3)", "expected": {"kind": "spill", "value": [[1], [2], [3]]}, "tolerance": 0}
{"id": "array-002", "area": "array", "source": "excel", "notes": "SEQUENCE rows, cols", "formula": "=SEQUENCE(2,2)", "expected": {"kind": "spill", "value": [[1, 2], [3, 4]]}, "tolerance": 0}
{"id": "array-003", "area": "array", "source": "excel", "notes": "UNIQUE keeps order of first appearance", "cells": [{"addr": "D1", "kind": "number", "value": 3}, {"addr": "D2", "kind": "number", "value": 1}, {"addr": "D3", "kind": "number", "value": 2}, {"addr": "D4", "kind": "number", "value": 2}], "formula": "=UNIQUE(D1:D4)", "expected": {"kind": "spill", "value": [[3], [1], [2]]}, "tolerance": 0}
{"id": "array-004", "area": "array", "source": "excel", "notes": "SORT ascending", "cells": [{"addr": "D1", "kind": "number", "value": 3}, {"addr": "D2", "kind": "number", "value": 1}, {"addr": "D3", "kind": "number", "value": 2}, {"addr": "D4", "kind": "number", "value": 2}], "formula": "=SORT(D1:D4)", "expected": {"kind": "spill", "value": [[1], [2], [2], [3]]}, "tolerance": 0}
{"id": "array-005", "area": "array", "source": "excel", "notes": "FILTER keeps source order", "cells": [{"addr": "D1", "kind": "number", "value": 3}, {"addr": "D2", "kind": "number", "value": 1}, {"addr": "D3", "kind": "number", "value": 2}, {"addr": "D4", "kind": "number", "value": 2}], "formula": "=FILTER(D1:D4,D1:D4>1)", "expected": {"kind": "spill", "value": [[3], [2], [2]]}, "tolerance": 0}
{"id": "array-006", "area": "array", "source": "excel", "notes": "FILTER with no matches yields #CALC!", "cells": [{"addr": "D1", "kind": "number", "value": 3}, {"addr": "D2", "kind": "number", "value": 1}], "formula": "=FILTER(D1:D2,D1:D2>10)", "expected": {"kind": "error", "value": "#CALC!"}}
{"id": "array-007", "area": "array", "source": "excel", "notes": "Array result consumed by SUM", "formula": "=SUM(SEQUENCE(4))", "expected": {"kind": "number", "value": 10}, "tolerance": 0}
{"id": "array-008", "area": "array", "source": "authored", "notes": "Array constants in SUMPRODUCT", "formula": "=SUMPRODUCT({1,2},{3,4})", "expected": {"kind": "number", "value": 11}, "tolerance": 0}
{"id": "array-009", "area": "array", "source": "excel", "notes": "TRANSPOSE row to column shape", "cells": [{"addr": "D1", "kind": "number", "value": 3}, {"addr": "D2", "kind": "number", "value": 1}, {"addr": "D3", "kind": "number", "value": 2}, {"addr": "D4", "kind": "number", "value": 2}], "formula": "=TRANSPOSE(D1:D4)", "expected": {"kind": "spill", "value": [[3, 1, 2, 2]]}, "tolerance": 0}
{"id": "array-010", "area": "array", "source": "excel", "notes": "LET is Excel 365", "formula": "=LET(x,2,x*3)", "expected": {"kind": "number", "value": 6}, "tolerance": 0}
{"id": "array-011", "area": "array", "source": "authored", "notes": "Nested dynamic arrays", "cells": [{"addr": "D1", "kind": "number", "value": 3}, {"addr": "D2", "kind": "number", "value": 1}, {"addr": "D3", "kind": "number", "value": 2}, {"addr": "D4", "kind": "number", "value": 2}], "formula": "=SORT(UNIQUE(D1:D4))", "expected": {"kind": "spill", "value": [[1], [2], [3]]}, "tolerance": 0}
{"id": "error-001", "area": "error", "source": "excel", "notes": "Division by zero", "formula": "=1/0", "expected": {"kind": "error", "value": "#DIV/0!"}}
{"id": "error-002", "area": "error", "source": "excel", "notes": "Zero over zero", "formula": "=0/0", "expected": {"kind": "error", "value": "#DIV/0!"}}
{"id": "error-003", "area": "error", "source": "excel", "notes": "sqrt of negative", "formula": "=SQRT(-1)", "expected": {"kind": "error", "value": "#NUM!"}}
{"id": "error-004", "area": "error", "source": "excel", "notes": "Overflow", "formula": "=2^1024", "expected": {"kind": "error", "value": "#NUM!"}}
{"id": "error-005", "area": "error", "source": "excel", "notes": "Text plus number", "formula": "=\"a\"+1", "expected": {"kind": "error", "value": "#VALUE!"}}
{"id": "error-006", "area": "error", "source": "excel", "notes": "NA()", "formula": "=NA()", "expected": {"kind": "error", "value": "#N/A"}}
{"id": "error-007", "area": "error", "source": "excel", "notes": "IFERROR catches div by zero", "formula": "=IFERROR(1/0,\"x\")", "expected": {"kind": "text", "value": "x"}}
{"id": "error-008", "area": "error", "source": "excel", "notes": "IFNA catches #N/A", "formula": "=IFNA(NA(),\"x\")", "expected": {"kind": "text", "value": "x"}}
{"id": "error-009", "area": "error", "source": "excel", "notes": "ISERROR true for #DIV/0!", "formula": "=ISERROR(1/0)", "expected": {"kind": "bool", "value": true}}
{"id": "error-010", "area": "error", "source": "excel", "notes": "ISNA true for #N/A", "formula": "=ISNA(NA())", "expected": {"kind": "bool", "value": true}}
{"id": "error-011", "area": "error", "source": "excel", "notes": "IF evaluates only the chosen branch", "formula": "=IF(TRUE,1,1/0)", "expected": {"kind": "number", "value": 1}, "tolerance": 0}
{"id": "error-012", "area": "error", "source": "excel", "notes": "IF chooses unchecked branch", "formula": "=IF(FALSE,1/0,2)", "expected": {"kind": "number", "value": 2}, "tolerance": 0}
{"id": "error-013", "area": "error", "source": "excel", "notes": "Numeric condition coerces to TRUE", "formula": "=IF(1,2,3)", "expected": {"kind": "number", "value": 2}, "tolerance": 0}
{"id": "error-014", "area": "error", "source": "excel", "notes": "Error propagates through arithmetic", "formula": "=1/0+1", "expected": {"kind": "error", "value": "#DIV/0!"}}
{"id": "error-015", "area": "error", "source": "excel", "notes": "SUM of direct text argument is #VALUE!", "formula": "=SUM(1,\"a\")", "expected": {"kind": "error", "value": "#VALUE!"}}
{"id": "error-016", "area": "error", "source": "excel", "notes": "SUM ignores text inside a range", "cells": [{"addr": "G1", "kind": "number", "value": 1}, {"addr": "G2", "kind": "text", "value": "x"}, {"addr": "G3", "kind": "number", "value": 3}], "formula": "=SUM(G1:G3)", "expected": {"kind": "number", "value": 4}, "tolerance": 0}
{"id": "error-017", "area": "error", "source": "excel", "notes": "Text and number are not equal", "formula": "=\"1\"=1", "expected": {"kind": "bool", "value": false}}
{"id": "error-018", "area": "error", "source": "excel", "notes": "Concatenation operator", "formula": "=1&2", "expected": {"kind": "text", "value": "12"}}
{"id": "error-019", "area": "error", "source": "excel", "notes": "Boolean coerces to 1 in arithmetic", "formula": "=TRUE+1", "expected": {"kind": "number", "value": 2}, "tolerance": 0}
{"id": "error-020", "area": "error", "source": "excel", "notes": "CHOOSE index out of range", "formula": "=CHOOSE(0,1,2)", "expected": {"kind": "error", "value": "#VALUE!"}}
{"id": "error-021", "area": "error", "source": "excel", "notes": "INDEX row out of range", "cells": [{"addr": "B1", "kind": "text", "value": "a"}, {"addr": "B2", "kind": "text", "value": "b"}, {"addr": "B3", "kind": "text", "value": "c"}, {"addr": "B4", "kind": "text", "value": "d"}], "formula": "=INDEX(B1:B4,5)", "expected": {"kind": "error", "value": "#REF!"}}
{"id": "error-022", "area": "error", "source": "excel", "notes": "Unknown function name", "formula": "=FOOBAR(1)", "expected": {"kind": "error", "value": "#NAME?"}}
{"id": "error-023", "area": "error", "source": "excel", "notes": "IFERROR around lazy IF", "formula": "=IFERROR(IF(TRUE,1,1/0),0)", "expected": {"kind": "number", "value": 1}, "tolerance": 0}
{"id": "fp-001", "area": "fp", "source": "ieee", "notes": "Classic binary representation", "formula": "=0.1+0.2", "expected": {"kind": "number", "value": 0.30000000000000004}, "tolerance": 0}
{"id": "fp-002", "area": "fp", "source": "excel", "notes": "Excel compares stored doubles, so FALSE", "formula": "=0.1+0.2=0.3", "expected": {"kind": "bool", "value": false}}
{"id": "fp-003", "area": "fp", "source": "excel", "notes": "Rounding masks the representation error", "formula": "=ROUND(0.1+0.2,1)=0.3", "expected": {"kind": "bool", "value": true}}
{"id": "fp-004", "area": "fp", "source": "excel", "notes": "Excel rounds to 15 significant digits first, then to 2 places: 2.68 (not IEEE naive 2.67)", "formula": "=ROUND(2.675,2)", "expected": {"kind": "number", "value": 2.68}, "tolerance": 0}
